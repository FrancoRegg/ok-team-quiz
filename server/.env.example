# Puerto del servidor
PORT=3000

# Configuración de PostgreSQL
PGDATABASE=nombre_base_datos
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=tu_password_postgres

# URL del cliente (frontend)
CLIENT_URL=http://localhost:5173

# Secret para JWT (generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=genera_una_clave_aleatoria_de_64_bytes_aqui

# Entorno
NODE_ENV=development

# Opcional: IP de tu PC en la red local, para probar desde el celular
# (habilita ese origen en CORS, también con `npm run dev:https`)
# LOCAL_IP=192.168.1.10

# En producción la conexión a la base se toma de DATABASE_URL y las
# variables PG* de arriba no se usan. La plataforma suele definirla sola.