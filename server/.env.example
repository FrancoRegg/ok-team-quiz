# Puerto del servidor
PORT=3000

# Contraseña de admin
ADMIN_PASSWORD=tu_password_segura_aqui

# Configuración de PostgreSQL
PGDATABASE=nombre_base_datos
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=tu_password_postgres

# URL del cliente (frontend)
CLIENT_URL=http://localhost:5173

# Secret para JWT (generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=genera_una_clave_aleatoria_de_64_bytes_aqui

# Entorno
NODE_ENV=development